{
  "expo": {
    "name": "Blink Orbit",
    "slug": "blink-orbit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "blinkorbit",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#04120C",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "in.blinkmoney.orbit",
      "adaptiveIcon": {
        "backgroundColor": "#04120C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#04120C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a346a0a9-444f-4d18-adf4-3e5a8f8d6dd8"
      }
    },
    "owner": "anujshaan",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a346a0a9-444f-4d18-adf4-3e5a8f8d6dd8"
    }
  }
}
